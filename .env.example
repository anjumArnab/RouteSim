# Copy to .env and fill in. The server will not start without at least one key.
#
# Format: name:token[,name2:token2]
# Each name is a separate agent with its own isolated episodes.
# Tokens need at least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ROUTESIM_API_KEYS=

# Use 0.0.0.0 to accept connections from other machines.
ROUTESIM_HOST=127.0.0.1
ROUTESIM_PORT=8000
